# Nebius Token Factory credentials
# Get these from https://tokenfactory.nebius.com after redeeming hackathon credits
# (form + activation code NEBIUS-DEVPOST-GLOBAL26)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model IDs — confirm exact catalog names in the Token Factory console before running
NEMOTRON_REASONING_MODEL=nvidia/nemotron-3-ultra
NEMOTRON_FAST_MODEL=nvidia/nemotron-3-nano

# Demo mode: rule-based mock "findings" instead of real Nemotron calls.
# Auto-enabled when NEBIUS_API_KEY is empty. Leave unset for that default,
# or force it explicitly:
#   DEMO_MODE=true   -- always mock, even if a real key is set
#   DEMO_MODE=false  -- always call the real API, error out if no key
DEMO_MODE=
